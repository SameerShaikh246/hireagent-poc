generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Candidate {
  id                      String                   @id @default(cuid())
  fullName                String
  currentTitle            String?
  currentCompany          String?
  location                String?
  summary                 String?
  experienceYears         Int?
  educationLevel          String?
  estimatedSalaryMin      Int?
  estimatedSalaryMax      Int?
  estimatedSalaryCurrency String?                  @default("USD")
  salarySource            String?
  openToWork              OpenToWorkStatus         @default(UNKNOWN)
  openToWorkEvidence      String?
  openToWorkSource        String?
  profileTrustScore       Int                      @default(0)
  firstSeenAt             DateTime                 @default(now())
  lastSeenAt              DateTime                 @updatedAt
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  certifications          CandidateCertification[]
  identities              CandidateIdentity[]
  providerRecords         CandidateProvider[]
  skills                  CandidateSkill[]
  searchHistory           SearchHistory[]
  searchResults           SearchResult[]

  @@index([fullName])
}

model CandidateIdentity {
  id          String       @id @default(cuid())
  candidateId String
  type        IdentityType
  value       String
  createdAt   DateTime     @default(now())
  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([candidateId])
}

model CandidateProvider {
  id                  String    @id @default(cuid())
  candidateId         String
  provider            Provider
  providerCandidateId String?
  profileUrl          String?
  rawData             Json
  fetchedAt           DateTime  @default(now())
  candidate           Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([provider, providerCandidateId])
}

model CandidateSkill {
  id          String      @id @default(cuid())
  candidateId String
  skill       String
  source      SkillSource
  confidence  Float?
  createdAt   DateTime    @default(now())
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skill])
  @@index([candidateId])
}

model CandidateCertification {
  id          String              @id @default(cuid())
  candidateId String
  name        String
  issuer      String?
  source      CertificationSource
  sourceUrl   String?
  confidence  Float?
  createdAt   DateTime            @default(now())
  candidate   Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model Search {
  id               String         @id @default(cuid())
  provider         Provider
  jobTitle         String
  mandatorySkills  String[]
  mustHaveSkills   String[]
  niceToHaveSkills String[]
  location         String?
  freshSearch      Boolean        @default(false)
  totalFound       Int?
  creditsUsed      Int?
  createdAt        DateTime       @default(now())
  results          SearchResult[]
}

model SearchResult {
  id                  String    @id @default(cuid())
  searchId            String
  candidateId         String
  provider            Provider
  relevanceScore      Int
  matchedSkills       String[]
  missingSkills       String[]
  excludedByFreshness Boolean   @default(false)
  createdAt           DateTime  @default(now())
  candidate           Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  search              Search    @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([searchId])
  @@index([candidateId])
}

model SearchHistory {
  id                String    @id @default(cuid())
  candidateId       String
  searchContextHash String
  jobTitleSnapshot  String
  firstSeenAt       DateTime  @default(now())
  lastSeenAt        DateTime  @updatedAt
  timesSeen         Int       @default(1)
  candidate         Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, searchContextHash])
  @@index([searchContextHash])
}

enum Provider {
  PDL
  GITHUB
  TAVILY
  EXA
  SERPER
  INTERNAL_DB
}

enum IdentityType {
  LINKEDIN_URL
  GITHUB_URL
  PORTFOLIO_URL
  PDL_ID
  GITHUB_LOGIN
  EMAIL_HASH
  NAME_COMPANY
}

enum OpenToWorkStatus {
  YES
  NO
  UNKNOWN
}

enum SkillSource {
  PDL_STRUCTURED
  GITHUB_LANGUAGE
  BIO_EXTRACTED
  GROQ_ENRICHED
}

enum CertificationSource {
  PDL
  WEB_EXTRACTED
}
